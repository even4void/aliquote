@Misc{wang-2021-on-matching-adjusted,
  abstract	= {Indirect comparisons have been increasingly used to compare data from different sources such as clinical trials and observational data in, e.g., a disease registry. To adjust for population differences between data sources, matching-adjusted indirect comparison (MAIC) has been used in several applications including health technology assessment and drug regulatory submissions. In fact, MAIC can be considered as a special case of a range of methods known as calibration estimation in survey sampling. However, to our best knowledge, this connection has not been examined in detail. This paper makes three contributions: 1. We examined this connection by comparing MAIC and a few commonly used calibration estimation methods, including the entropy balancing approach, which is equivalent to MAIC. 2. We considered the standard error (SE) estimation of the MAIC estimators and propose a model-independent SE estimator and examine its performance by simulation. 3. We conducted a simulation to compare these commonly used approaches to evaluate their performance in indirect comparison scenarios.},
  annote	= {https://aliquote.org/post/arxiv-06/},
  author	= {Jixian Wang},
  comments	= {26 pages, 1 figure},
  date-added	= {2026-08-18 15:22:44 +0200},
  date-modified	= {2026-08-18 15:23:23 +0200},
  eprint	= {arXiv:2107.11687},
  keywords	= {statistics, calibration},
  title		= {{O}n matching-adjusted indirect comparison and calibration estimation},
  url		= {http://arxiv.org/abs/2107.11687},
  year		= {2021}
}

