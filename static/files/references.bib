  keywords	= {compiler, julia},
  title		= {{T}ype {S}tability in {J}ulia: {A}voiding {P}erformance {P}athologies in {J}{I}{T} {C}ompilation ({E}xtended {V}ersion)},
  url		= {http://arxiv.org/abs/2109.01950},
  year		= {2021}
}

